# ============================================
#  小寒影 · 环境变量配置（模板）
#  复制本文件为 .env，填上你自己的 API Key 后启动
#  ⚠️ 本文件不含任何 Key，请使用你自己的 Key
# ============================================

# ====== 默认模型 ======
# 填下面某个模型的 KEY（例如 MODEL_1_KEY 填的是 deepseek，这里就填 deepseek）
DEFAULT_MODEL=deepseek

# ====== 模型列表 ======
# 想配几个模型，MODEL_COUNT 就填几，从 1 开始连续编号。
# 任何 OpenAI 兼容接口都能用（DeepSeek / SenseNova / OpenAI / Kimi / 智谱 / vLLM ...）
MODEL_COUNT=2

# ---- 模型 1 ----
MODEL_1_KEY=deepseek
MODEL_1_NAME=DeepSeek
MODEL_1_API_KEY=
MODEL_1_BASE_URL=https://api.deepseek.com
MODEL_1_MODEL_ID=deepseek-chat
MODEL_1_VISION=false

# ---- 模型 2 ----
MODEL_2_KEY=sensenova
MODEL_2_NAME=SenseNova
MODEL_2_API_KEY=
MODEL_2_BASE_URL=https://token.sensenova.cn/v1
MODEL_2_MODEL_ID=sensenova-6.8-flash-lite
MODEL_2_VISION=true

# 想再加模型就继续写 MODEL_3_*、MODEL_4_* ...，并把 MODEL_COUNT 改大。

# ====== 讨论模式里谁用哪个模型（可选）======
# 不填则自动分配：engineer / moderator 用第 1 个模型，critic 用第 2 个模型。
# 指定时填上面某个模型的 KEY。
DISCUSSION_ENGINEER_MODEL=
DISCUSSION_CRITIC_MODEL=
DISCUSSION_MODERATOR_MODEL=

# ====== 上传目录 ======
UPLOAD_DIR=uploads

# ====== Blender 建模配置（可选）======
# 不填 BLENDER_PATH 会自动探测（注册表 → 常见安装目录 → 微软商店版）。
# 手动指定示例（去掉前面的 #）：
# BLENDER_PATH=D:\Blender Foundation\Blender 3.6\blender.exe
# 实时模式服务端口（在 Blender 里运行 scripts/blender_live_server.py 后生效）
# BLENDER_LIVE_PORT=9876

# ====== 多模型讨论配置（可选）======
# 每个参与者单次发言的 max_tokens 上限（reasoning + 正文的总量）。
# 推理模型挑刺时 reasoning 特别长，额度给小了会「想很久 / 正文为空」。默认 8000。
DISCUSSION_MAX_TOKENS=8000

# ====== Agent 引擎配置（可选）======
# 单轮任务最大执行步数（工具调用轮次），默认 50，复杂任务可调大
# AGENT_MAX_STEPS=50
